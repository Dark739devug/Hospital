# Copiar como .env (en esta misma carpeta) y completar. El .env real no se sube a git.
# application.properties lo importa con spring.config.import=optional:file:.env[.properties]

# PostgreSQL (opcionales: DB_URL, o DB_HOST / DB_PORT / DB_NAME; por defecto localhost:5432/Hospital)
DB_USER=postgres
DB_PASSWORD=

# Secreto para firmar los JWT (mínimo 32 caracteres)
JWT_SECRET=

# Administrador inicial: solo se usa si el usuario 'admin' todavía no existe
ADMIN_USER=admin
ADMIN_PASSWORD=
